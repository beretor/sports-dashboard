# Copie ce fichier en .env pour le développement local
# Ne committe JAMAIS .env dans Git

# ── Strava ────────────────────────────────────────────────────────────────────
# Mode REST (défaut) — credentials disponibles sur https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
# Obtenu via : python scripts/strava_auth.py
STRAVA_REFRESH_TOKEN=your_refresh_token

# Mode MCP — alternative sans gestion manuelle de l'OAuth
# Connecter d'abord via Claude : "Connect my Strava account"
# Puis activer avec :
# STRAVA_USE_MCP=true

# ── Garmin Connect ────────────────────────────────────────────────────────────
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_password

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
